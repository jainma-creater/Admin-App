# =============================================================================
#  Branch Visit Inspection — PRODUCTION environment (copy to .env.prod)
#  Never commit real values. Generate with:
#    openssl rand -hex 32         (JWT_SECRET)
#    openssl rand -base64 18      (POSTGRES_PASSWORD, SUPER_ADMIN_PASSWORD)
# =============================================================================

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=bv_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=bv_inspection

# ---- App / security --------------------------------------------------------
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM
DOMAIN=branchvisits.example.com           # real hostname pointing at this EC2
ENVIRONMENT=production
# SEED_DEMO=false (optional — never create demo data in production)

# ---- Bootstrap admin (created by seed.py on first boot) --------------------
SUPER_ADMIN_EMAIL=admin@company.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG

# ---- CORS (comma-safe JSON handled by backend CORS_ORIGINS override) -------
# Domains allowed to call the API directly (web app uses same-origin via nginx).

# ---- OPTIONAL: legacy photo read-back from an existing S3/MinIO bucket ------
# Only needed if photos from an older deployment live in object storage and you
# still want to view them. New photos always go into PostgreSQL.
# MINIO_ENDPOINT=s3.amazonaws.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# MINIO_SECURE=true
# MINIO_REGION=ap-south-1

# ---- OPTIONAL: S3 backups (deploy/backup.sh) --------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_BACKUPS=
# AWS_REGION=ap-south-1