{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BranchVisitPhotosBucket",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:CreateBucket"
      ],
      "Resource": [
        "arn:aws:s3:::branchvisit-photos-prod",
        "arn:aws:s3:::branchvisit-photos-prod/*"
      ]
    }
  ]
}
