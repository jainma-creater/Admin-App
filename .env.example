# ============================================
# Branch Visit Inspection System - Environment
# ============================================

# Database
DATABASE_URL=postgresql+asyncpg://bv_user:bv_password@localhost:5432/bv_inspection

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
# Generate a strong secret before any deployment (do NOT reuse the default):
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ISSUER=branchvisit-system
# JWT_AUDIENCE=branchvisit-api

# Rate limiting (Redis-backed; memory fallback when Redis is down)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN_PER_MINUTE=60
# RATE_LIMIT_REGISTER_PER_HOUR=60
# RATE_LIMIT_REFRESH_PER_MINUTE=120
# RATE_LIMIT_API_PER_MINUTE=600

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=branch-visit-photos
MINIO_SECURE=false

# App
APP_NAME=Branch Visit Inspection
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Super Admin
SUPER_ADMIN_EMAIL=admin@company.com
SUPER_ADMIN_PASSWORD=change-this-password

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081"]

# FCM (Firebase Cloud Messaging) - Optional
FCM_CREDENTIALS_PATH=

# GPS
GPS_ENABLED=true

# Photo
MAX_PHOTO_SIZE_MB=10
PHOTO_QUALITY=80
THUMBNAIL_SIZE=200
