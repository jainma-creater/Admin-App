# Copy this file to .env and set your machine's LAN IP (ipconfig / ifconfig)
# Find it with: ipconfig  (Windows)  |  ifconfig / ip addr  (Mac/Linux)
# Use the IPv4 address of your Wi-Fi adapter, e.g. 192.168.1.20
#
# Leave EMPTY (or delete this file) to auto-detect: Expo Go on a real phone
# automatically targets the machine running Metro — recommended, nothing to configure.
#
# The backend runs in Docker and is published on host port 8010
# (port 8000 was already taken on this machine by a Supabase stack):
#   docker compose up -d backend
#
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8010/api/v1
